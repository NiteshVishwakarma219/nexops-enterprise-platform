# EEMS Backend Environment
NODE_ENV=development
PORT=8000

# PostgreSQL / Prisma
# Local example:
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.zelkouvudknjhijppvlo:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.zelkouvudknjhijppvlo:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Authentication
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_KEY
RESET_TOKEN_EXPIRE_MINUTES=10

# Frontend / CORS
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Optional email configuration
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=
RESEND_API_KEY=
